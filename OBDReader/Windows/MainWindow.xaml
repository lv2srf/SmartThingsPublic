<Window x:Class="OBDReader.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="OBD-II Diagnostic Tool - 2008 GMC Yukon Denali"
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Car" Width="32" Height="32" Foreground="#00BCD4" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="OBD-II Diagnostic Tool" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Foreground="White"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <ComboBox x:Name="PortComboBox" Width="150" materialDesign:HintAssist.Hint="COM Port" Foreground="White" BorderBrush="#00BCD4"/>
                    <Button x:Name="ConnectButton" Content="Connect" Width="100" Click="ConnectButton_Click"
                            Background="#00BCD4" Foreground="White" BorderThickness="0" Padding="10,5"/>
                    <Button x:Name="DisconnectButton" Content="Disconnect" Width="100" Click="DisconnectButton_Click"
                            Background="#D32F2F" Foreground="White" BorderThickness="0" Padding="10,5" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="1" Margin="10" Background="#252526" BorderThickness="0">

            <!-- Dashboard Tab -->
            <TabItem Header="Dashboard" Foreground="White">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Key Metrics -->
                    <UniformGrid Grid.Row="0" Rows="2" Columns="4" Margin="0,0,0,20">
                        <!-- Engine RPM -->
                        <Border Background="#2D2D30" Margin="5" Padding="15" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="Engine RPM" FontSize="12" Foreground="#B0B0B0"/>
                                <TextBlock x:Name="RPMText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#00BCD4"/>
                                <TextBlock Text="RPM" FontSize="10" Foreground="#B0B0B0"/>
                            </StackPanel>
                        </Border>

                        <!-- Vehicle Speed -->
                        <Border Background="#2D2D30" Margin="5" Padding="15" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="Vehicle Speed" FontSize="12" Foreground="#B0B0B0"/>
                                <TextBlock x:Name="SpeedText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#4CAF50"/>
                                <TextBlock Text="km/h" FontSize="10" Foreground="#B0B0B0"/>
                            </StackPanel>
                        </Border>

                        <!-- Coolant Temp -->
                        <Border Background="#2D2D30" Margin="5" Padding="15" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="Coolant Temp" FontSize="12" Foreground="#B0B0B0"/>
                                <TextBlock x:Name="CoolantTempText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#FF9800"/>
                                <TextBlock Text="°C" FontSize="10" Foreground="#B0B0B0"/>
                            </StackPanel>
                        </Border>

                        <!-- Throttle Position -->
                        <Border Background="#2D2D30" Margin="5" Padding="15" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="Throttle Position" FontSize="12" Foreground="#B0B0B0"/>
                                <TextBlock x:Name="ThrottleText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#9C27B0"/>
                                <TextBlock Text="%" FontSize="10" Foreground="#B0B0B0"/>
                            </StackPanel>
                        </Border>

                        <!-- Engine Load -->
                        <Border Background="#2D2D30" Margin="5" Padding="15" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="Engine Load" FontSize="12" Foreground="#B0B0B0"/>
                                <TextBlock x:Name="EngineLoadText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#E91E63"/>
                                <TextBlock Text="%" FontSize="10" Foreground="#B0B0B0"/>
                            </StackPanel>
                        </Border>

                        <!-- Fuel Level -->
                        <Border Background="#2D2D30" Margin="5" Padding="15" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="Fuel Level" FontSize="12" Foreground="#B0B0B0"/>
                                <TextBlock x:Name="FuelLevelText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#FFC107"/>
                                <TextBlock Text="%" FontSize="10" Foreground="#B0B0B0"/>
                            </StackPanel>
                        </Border>

                        <!-- Intake Air Temp -->
                        <Border Background="#2D2D30" Margin="5" Padding="15" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="Intake Air Temp" FontSize="12" Foreground="#B0B0B0"/>
                                <TextBlock x:Name="IntakeAirTempText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#00BCD4"/>
                                <TextBlock Text="°C" FontSize="10" Foreground="#B0B0B0"/>
                            </StackPanel>
                        </Border>

                        <!-- Battery Voltage -->
                        <Border Background="#2D2D30" Margin="5" Padding="15" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="Battery Voltage" FontSize="12" Foreground="#B0B0B0"/>
                                <TextBlock x:Name="VoltageText" Text="0.0" FontSize="32" FontWeight="Bold" Foreground="#8BC34A"/>
                                <TextBlock Text="V" FontSize="10" Foreground="#B0B0B0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Additional Data Grid -->
                    <DataGrid Grid.Row="1" x:Name="LiveDataGrid" AutoGenerateColumns="False"
                              Background="#2D2D30" Foreground="White" GridLinesVisibility="None"
                              HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Parameter" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="100"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Trouble Codes Tab -->
            <TabItem Header="Trouble Codes" Foreground="White">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Read Codes" Click="ReadCodesButton_Click" Width="120" Margin="5" Background="#00BCD4" Foreground="White"/>
                        <Button Content="Clear Codes" Click="ClearCodesButton_Click" Width="120" Margin="5" Background="#D32F2F" Foreground="White"/>
                        <Button Content="Read Pending" Click="ReadPendingButton_Click" Width="120" Margin="5" Background="#FF9800" Foreground="White"/>
                    </StackPanel>

                    <!-- DTC List -->
                    <DataGrid Grid.Row="1" x:Name="DTCDataGrid" AutoGenerateColumns="False"
                              Background="#2D2D30" Foreground="White" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="100" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Summary -->
                    <Border Grid.Row="2" Background="#2D2D30" Padding="10" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Total Codes: " FontWeight="Bold"/>
                            <TextBlock x:Name="TotalCodesText" Text="0" Foreground="#00BCD4" Margin="5,0"/>
                            <TextBlock Text="Confirmed: " FontWeight="Bold" Margin="20,0,0,0"/>
                            <TextBlock x:Name="ConfirmedCodesText" Text="0" Foreground="#D32F2F" Margin="5,0"/>
                            <TextBlock Text="Pending: " FontWeight="Bold" Margin="20,0,0,0"/>
                            <TextBlock x:Name="PendingCodesText" Text="0" Foreground="#FF9800" Margin="5,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Freeze Frame Tab -->
            <TabItem Header="Freeze Frame" Foreground="White">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Read Freeze Frame" Click="ReadFreezeFrameButton_Click" Width="150" Margin="5" Background="#00BCD4" Foreground="White"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="FreezeFrameGrid" AutoGenerateColumns="False"
                              Background="#2D2D30" Foreground="White" GridLinesVisibility="None"
                              HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Parameter" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="100"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Vehicle Info Tab -->
            <TabItem Header="Vehicle Info" Foreground="White">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <Button Content="Read Vehicle Info" Click="ReadVehicleInfoButton_Click" Width="150" HorizontalAlignment="Left" Background="#00BCD4" Foreground="White"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,20">
                        <Border Background="#2D2D30" Padding="15" Margin="0,5" CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="VIN:" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" x:Name="VINText" Text="-" Foreground="#00BCD4"/>
                            </Grid>
                        </Border>

                        <Border Background="#2D2D30" Padding="15" Margin="0,5" CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Calibration ID:" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" x:Name="CalibrationIDText" Text="-" Foreground="#00BCD4"/>
                            </Grid>
                        </Border>

                        <Border Background="#2D2D30" Padding="15" Margin="0,5" CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Protocol:" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" x:Name="ProtocolText" Text="-" Foreground="#00BCD4"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Bidirectional Control Tab -->
            <TabItem Header="Actuator Tests" Foreground="White">
                <Grid Margin="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Bidirectional Control Tests" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                        <Border Background="#2D2D30" Padding="15" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="EVAP System Test" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                <TextBlock Text="Tests the evaporative emission control system for leaks" Foreground="#B0B0B0" Margin="0,0,0,10"/>
                                <Button Content="Run EVAP Test" Click="TestEVAPButton_Click" Width="150" HorizontalAlignment="Left" Background="#00BCD4" Foreground="White"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#2D2D30" Padding="15" Margin="0,10,0,0" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="Catalytic Converter Test" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                <TextBlock Text="Tests catalytic converter efficiency" Foreground="#B0B0B0" Margin="0,0,0,10"/>
                                <Button Content="Run Catalyst Test" Click="TestCatalystButton_Click" Width="150" HorizontalAlignment="Left" Background="#00BCD4" Foreground="White"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#FF9800" Padding="15" Margin="0,20,0,0" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="⚠ Warning" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="Actuator tests perform bidirectional control of vehicle systems. Only run these tests when safe to do so. Engine should be running for most tests." TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#007ACC" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse x:Name="ConnectionStatusIndicator" Width="12" Height="12" Fill="#D32F2F" Margin="0,0,10,0"/>
                    <TextBlock x:Name="StatusText" Text="Not Connected" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="2" x:Name="LastUpdateText" Text="Last Update: -" Foreground="White" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
